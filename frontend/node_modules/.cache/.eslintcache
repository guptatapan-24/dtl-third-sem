assigned a value but never used.",[0,2179],"import React, { useState, useEffect, createContext, useContext, useRef, useCallback } from 'react';\nimport './App.css';\nimport { Toaster, toast } from 'sonner';\nimport { \n  Car, MapPin, Calendar, Clock, Users, DollarSign, \n  LogOut, User, Home, Search, Plus, CheckCircle, \n  XCircle, ChevronRight, Menu, X, Shield, Activity,\n  Upload, AlertCircle, Check, FileCheck, BadgeCheck,\n  MessageCircle, Send, Key, Play, Navigation as NavigationIcon,\n  Phone, AlertTriangle, CheckCircle2, Eye, EyeOff, MapPinned, Crosshair,\n  Repeat, Zap, Star, Filter, Building2, History, Award, ThumbsUp, ThumbsDown,\n  Leaf, TrendingUp, Trophy, Target, BarChart3, Flame, Tag, GraduationCap,\n  Flag, ClipboardList, Ban, UserX, UserCheck, ScrollText, Trash2, AlertOctagon,\n  WifiOff, Wifi\n} from 'lucide-react';\nimport { MapContainer, TileLayer, Marker, Polyline, useMapEvents, useMap } from 'react-leaflet';\nimport L from 'leaflet';\nimport 'leaflet/dist/leaflet.css';\n\n// ==========================================\n// OFFLINE DETECTION HOOK\n// ==========================================\nconst useOnlineStatus = () => {\n  const [isOnline, setIsOnline] = useState(navigator.onLine);\n\n  useEffect(() => {\n    const handleOnline = () => {\n      setIsOnline(true);\n      toast.success('Back online! Map features available.');\n    };\n    const handleOffline = () => {\n      setIsOnline(false);\n      toast.info('You are offline. Manual location entry enabled.');\n    };\n\n    window.addEventListener('online', handleOnline);\n    window.addEventListener('offline', handleOffline);\n\n    return () => {\n      window.removeEventListener('online', handleOnline);\n      window.removeEventListener('offline', handleOffline);\n    };\n  }, []);\n\n  return isOnline;\n};\n\n// Offline Mode Badge Component\nconst OfflineBadge = ({ isOnline }) => {\n  if (isOnline) return null;\n  \n  return (\n    <div className=\"fixed bottom-4 right-4 z-50 bg-yellow-500/20 border border-yellow-500/50 rounded-xl px-4 py-2 flex items-center gap-2 animate-fade-in\" data-testid=\"offline-badge\">\n      <WifiOff className=\"w-4 h-4 text-yellow-400\" />\n      <span className=\"text-yellow-400 text-sm font-medium\">Offline Mode</span>\n    </div>\n  );\n};",{"desc":"90","fix":"91"},{"desc":"92","fix":"93"},{"desc":"94","fix":"95"},{"desc":"96","fix":"97"},{"desc":"98","fix":"99"},{"desc":"100","fix":"101"},{"desc":"102","fix":"103"},{"desc":"104","fix":"105"},"Update the dependencies array to be: [loadMessages, requestId]",{"range":"106","text":"107"},"Update the dependencies array to be: [loadRideData, requestId]",{"range":"108","text":"109"},"Update the dependencies array to be: [filter, loadSOS]",{"range":"110","text":"111"},"Update the dependencies array to be: [loadData]",{"range":"112","text":"113"},"Update the dependencies array to be: [filter, loadVerifications]",{"range":"114","text":"115"},"Update the dependencies array to be: [filter, loadReports]",{"range":"116","text":"117"},"Update the dependencies array to be: [filter, limit, loadLogs]",{"range":"118","text":"119"},"Update the dependencies array to be: [statusFilter, dateFrom, dateTo, loadRides]",{"range":"120","text":"121"},[39416,39427],"[loadMessages, requestId]",[45572,45583],"[loadRideData, requestId]",[103839,103847],"[filter, loadSOS]",[165693,165695],"[loadData]",[226039,226047],"[filter, loadVerifications]",[275754,275762],"[filter, loadReports]",[286312,286327],"[filter, limit, loadLogs]",[292680,292712],"[statusFilter, dateFrom, dateTo, loadRides]"]